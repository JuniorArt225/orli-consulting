# Sanity — valeurs publiques, lues au moment du build.
PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-10-01

# Optionnel : token lecture si le dataset est privé (à mettre en secret GitHub).
SANITY_READ_TOKEN=

# Formulaire : endpoint Formspree / Basin… (vide = repli mailto:).
PUBLIC_FORM_ENDPOINT=
