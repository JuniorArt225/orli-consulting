---
import Icon from '@/components/Icon.astro';

// Bandeau doré pleine largeur, juste avant le footer.
---

<section class="bg-gold text-navy" aria-labelledby="cta-banner-title">
  <div class="container-orli grid gap-8 py-14 sm:py-16 lg:grid-cols-12 lg:items-center lg:gap-10">
    <h2
      id="cta-banner-title"
      class="text-[clamp(1.7rem,1.15rem+2vw,2.7rem)] leading-[1.2] font-extrabold tracking-[-0.028em] lg:col-span-8"
    >
      Un premier échange de <span class="double-rule cta-rule">30 minutes</span> suffit pour savoir où vous en êtes.
    </h2>
    <div class="lg:col-span-4 lg:justify-self-end">
      <a href="/contact/#diagnostic" class="btn btn-navy">
        Prendre rendez-vous
        <Icon name="arrow-right" class="h-4 w-4" data-icon="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .cta-rule::before,
  .cta-rule::after {
    color: var(--color-navy);
  }

</style>
