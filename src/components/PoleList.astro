---
import Icon from '@/components/Icon.astro';
import { poles, type PoleSlug } from '@/lib/content';

interface Props {
  headingLevel?: 'h3' | 'h4';
  /** Pôle à exclure (page d'un pôle : « les autres pôles »). */
  exclude?: PoleSlug;
}

const { headingLevel: Heading = 'h4', exclude } = Astro.props;
const list = poles.filter((pole) => pole.slug !== exclude);
---

<ul class="border-t border-navy/12">
  {
    list.map((pole) => {
      const free = pole.offers.find((offer) => offer.free);
      return (
        <li class="pole-row group relative border-b border-navy/12">
          <div class="relative grid gap-3 py-7 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-6 lg:py-9">
            <div>
              <Heading class="text-2xl font-bold tracking-[-0.02em] text-navy sm:text-[28px]">
                <a href={pole.href} class="pole-link">
                  {pole.title}
                </a>
              </Heading>
              <p class="mt-2 max-w-xl text-[16px] leading-relaxed text-navy/70">{pole.description}</p>
              <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-navy/75">
                <span class="tabular">{pole.offers.length} offres</span>
                {free && <span>{free.title}</span>}
              </p>
            </div>
            <span class="pole-arrow hidden sm:grid" aria-hidden="true">
              <Icon name="arrow-right" class="h-5 w-5" />
            </span>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .pole-row::before {
    content: '';
    position: absolute;
    /* Déborde dans la gouttière sans jamais dépasser l'écran (16px sur mobile). */
    inset: 0 -0.75rem;
    border-radius: 14px;
    background: var(--color-gray-light);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  /* Toute la ligne est cliquable ; le lien reste le seul élément focalisable. */
  .pole-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pole-arrow {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(10 25 47 / 0.18);
    color: var(--color-navy);
    transition:
      background-color 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease,
      transform 360ms var(--ease-out-expo);
  }

  @media (hover: hover) {
    .pole-row:hover::before {
      opacity: 1;
    }

    .pole-row:hover .pole-arrow {
      background: var(--color-navy);
      box-shadow: inset 0 0 0 1px var(--color-navy);
      color: #fff;
      transform: translateX(4px);
    }
  }

  .pole-row:focus-within::before {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .pole-row::before {
      inset: 0 -1.25rem;
    }
  }
</style>
