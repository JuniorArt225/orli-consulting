---
import BlogCard from '@/components/BlogCard.astro';
import Icon from '@/components/Icon.astro';
import { getLatestPosts } from '@/lib/sanity';

interface Props {
  headingLevel?: 'h3' | 'h4';
}

const { headingLevel = 'h4' } = Astro.props;

// Requête exécutée au build : le HTML livré sur LWS contient déjà les articles.
const posts = await getLatestPosts(3);
---

{
  posts.length > 0 ? (
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => (
        <BlogCard post={post} headingLevel={headingLevel} />
      ))}
    </div>
  ) : (
    <div class="flex flex-col items-start gap-4 rounded-2xl border border-dashed border-navy/20 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <p class="flex items-center gap-3 text-[15px] text-navy/75">
        <Icon name="file" class="h-5 w-5 text-navy/55" />
        Les premiers articles arrivent très bientôt.
      </p>
    </div>
  )
}

