---
import DiagnosticForm from '@/components/DiagnosticForm.astro';
import { heroStats } from '@/lib/content';
---

<section class="hero relative isolate overflow-hidden bg-navy text-white">
  <!-- Lumière douce derrière le formulaire : de la profondeur, pas un décor. -->
  <div class="hero-light" aria-hidden="true"></div>

  <div class="container-orli relative pt-12 pb-16 md:pt-16 lg:pt-20 lg:pb-24">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7 lg:pt-6">
        <p class="eyebrow enter-fade !leading-[1.7]">Cabinet de conseil en comptabilité&nbsp;·&nbsp;Abidjan</p>

        <h1 class="enter-title text-display mt-6 font-extrabold">
          Votre partenaire pour garantir l'existence, la conformité et la
          <span class="double-rule hero-rule text-gold">performance</span> de votre entreprise.
        </h1>

        <p class="enter-fade mt-6 max-w-[36rem] text-[17px] leading-relaxed text-white/75 sm:text-lg" style="--d: 180ms">
          Trois pôles d'expertise, une même exigence de fiabilité&nbsp;: comptabilité&nbsp;; juridique, social, fiscal &amp;
          paie&nbsp;; audit &amp; immobilisations.
        </p>

        <!-- Chiffres clés de la maquette. -->
        <dl class="enter-fade mt-10 grid max-w-xl grid-cols-3 gap-6 border-t border-white/15 pt-8" style="--d: 260ms">
          {
            heroStats.map((stat) => (
              <div class="flex flex-col-reverse justify-end gap-1.5">
                <dt class="text-[13px] leading-snug text-white/65 sm:text-sm">{stat.label}</dt>
                <dd class="tabular text-[clamp(1.6rem,1.2rem+1.4vw,2.35rem)] leading-none font-extrabold tracking-[-0.03em] text-gold">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero-form enter-rise lg:col-span-5">
        <div class="rounded-2xl bg-white p-5 text-navy sm:p-7">
          <DiagnosticForm id="diagnostic" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-light {
    position: absolute;
    inset: -20% -10% auto auto;
    width: min(900px, 90vw);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(27 49 87 / 0.9), transparent 70%);
    z-index: -1;
  }

  .hero-form > div {
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.75),
      0 2px 8px rgb(0 0 0 / 0.18);
  }

  /* Le double trait se trace sous « performance » après l'entrée du titre. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-rule::before {
      transition-delay: 620ms;
    }

    .hero-rule::after {
      transition-delay: 760ms;
    }
  }
</style>
