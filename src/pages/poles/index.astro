---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import NeedsRouter from '@/components/NeedsRouter.astro';
import OfferList from '@/components/OfferList.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import { faq, poles } from '@/lib/content';
---

<BaseLayout
  title="Nos pôles d'expertise — ORLI Consulting"
  description="Comptabilité ; juridique, social & paie ; audit & immobilisations : toutes les offres d'ORLI Consulting, et par où commencer selon votre situation."
>
  <PageHero
    crumbs={[{ label: 'Nos pôles' }]}
    title="Une maison, trois pôles d'expertise"
    lead="Chaque pôle a sa propre offre et ses propres interlocuteurs — tous partagent la même identité et la même exigence de fiabilité."
  >
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/contact/#diagnostic" class="btn btn-gold">
        Demander mon diagnostic gratuit
        <Icon name="arrow-right" class="h-4 w-4" data-icon="arrow" />
      </a>
      <a href="#par-ou-commencer" class="btn btn-line-light">
        Par où commencer&nbsp;?
        <Icon name="arrow-down" class="h-4 w-4" />
      </a>
    </div>

    <ul class="mt-12 grid gap-px overflow-hidden rounded-xl bg-white/12 sm:grid-cols-3">
      {
        poles.map((pole) => (
          <li class="bg-navy">
            <a href={`#${pole.slug}`} class="group flex h-full items-center justify-between gap-3 p-4 transition-colors hover:bg-navy-800">
              <span class="text-[15px] font-semibold text-white/90 group-hover:text-white">{pole.title}</span>
              <Icon name="arrow-down" class="h-4 w-4 text-white/60 transition-transform duration-300 group-hover:translate-y-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section id="par-ou-commencer" class="scroll-mt-24 py-20 sm:py-24 lg:py-28" aria-labelledby="start-title">
    <div class="container-orli grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="start-title" class="text-title font-extrabold text-navy">Par où commencer&nbsp;?</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-navy/75">
          Partez de votre situation&nbsp;: nous vous indiquons les offres qui y répondent et le pôle qui les porte.
        </p>
      </div>
      <div class="lg:col-span-8">
        <NeedsRouter formHref="/contact/" headingLevel="h3" />
      </div>
    </div>
  </section>

  {
    poles.map((pole) => (
      <section id={pole.slug} class="scroll-mt-20 border-t border-navy/10 py-16 sm:py-20 lg:py-24" aria-labelledby={`${pole.slug}-title`}>
        <div class="container-orli grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            <h2 id={`${pole.slug}-title`} class="text-title font-extrabold text-navy">
              {pole.title}
            </h2>
            <p class="mt-4 max-w-md text-[17px] leading-relaxed text-navy/75">{pole.description}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
              <a href={pole.href} class="btn btn-navy">
                Découvrir le pôle
                <Icon name="arrow-right" class="h-4 w-4" data-icon="arrow" />
              </a>
              <a href={`/contact/?pole=${pole.slug}#diagnostic`} class="btn btn-line">
                Diagnostic gratuit
              </a>
            </div>
          </div>
          <div class="lg:col-span-7">
            <OfferList offers={pole.offers} headingLevel="h3" />
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-gray-light py-20 sm:py-24 lg:py-28" aria-labelledby="faq-title">
    <div class="container-orli grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="faq-title" class="text-title font-extrabold text-navy">Questions fréquentes</h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
