---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import DiagnosticForm from '@/components/DiagnosticForm.astro';
import ContactTable from '@/components/ContactTable.astro';
import Faq from '@/components/Faq.astro';
import { faq } from '@/lib/content';
import { fr } from '@/lib/typo';

// Ce qui suit l'envoi : uniquement les délais publiés par le cabinet.
const next = [
  { before: 'Sous', figure: '48 h', after: ', un consultant vous répond', text: 'Par retour, pour convenir d’un premier échange.' },
  { before: 'Un premier échange de', figure: '30 minutes', after: '', text: 'Pour comprendre votre activité et votre besoin.' },
  { before: 'Votre diagnostic gratuit sous', figure: '5 à 10 jours', after: '', text: 'Un audit flash, sans engagement.' },
];
---

<BaseLayout
  title="Contact — ORLI Consulting"
  description="Demandez votre diagnostic gratuit ou écrivez-nous : un consultant vous répond sous 48 h. ORLI Consulting, Rue L120, Angré, Abidjan."
>
  <PageHero
    crumbs={[{ label: 'Contact' }]}
    title="Parlons de votre entreprise."
    lead={fr('Un premier échange de 30 minutes suffit pour savoir où vous en êtes. Laissez-nous vos coordonnées : un consultant vous répond sous 48 h.')}
  >
    <div class="mt-10">
      <ContactTable copy address tone="dark" />
    </div>

    <div slot="aside" class="rounded-2xl bg-white p-5 text-navy shadow-[0_40px_80px_-40px_rgb(0_0_0/0.75)] sm:p-7">
      <DiagnosticForm id="diagnostic" extended />
    </div>
  </PageHero>

  <section class="py-20 sm:py-24 lg:py-28" aria-labelledby="next-title">
    <div class="container-orli">
      <h2 id="next-title" class="text-title max-w-2xl font-extrabold text-navy">Ce qui se passe ensuite</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          next.map((item) => (
            <li class="border-t border-navy/15 pt-6">
              <h3 class="text-xl leading-snug font-bold tracking-[-0.02em] text-navy">
                {item.before} <span class="tabular whitespace-nowrap">{item.figure.replace(/ /g, '\u00a0')}</span>{item.after}
              </h3>
              <p class="mt-2 text-[16px] leading-relaxed text-navy/70">{item.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-12 max-w-2xl text-[16px] leading-relaxed text-navy/75">
        Ensuite, si vous le souhaitez&nbsp;: une proposition sur mesure, un pack adapté à votre taille, votre secteur et votre budget.
      </p>
    </div>
  </section>

  <section class="bg-gray-light py-20 sm:py-24 lg:py-28" aria-labelledby="faq-title">
    <div class="container-orli grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="faq-title" class="text-title font-extrabold text-navy">Questions fréquentes</h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faq} />
      </div>
    </div>
  </section>
</BaseLayout>

