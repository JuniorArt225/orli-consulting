---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { company, poles } from '@/lib/content';

const links = [
  { label: 'Accueil', href: '/', text: 'Le cabinet et son parcours en cinq étapes.' },
  { label: 'Nos pôles', href: '/poles/', text: 'Comptabilité\u00a0; juridique, social & paie\u00a0; audit & immobilisations.' },
  { label: 'Contact', href: '/contact/', text: 'Diagnostic gratuit, réponse sous 48 h.' },
];
---

<BaseLayout
  title="Page introuvable — ORLI Consulting"
  description="Cette page n'existe pas ou n'existe plus."
  noindex
>
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <div class="container-orli grid gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-7">
        <h1 class="enter-title text-display font-extrabold">Écart de rapprochement.</h1>
        <p class="enter-fade mt-6 max-w-xl text-lg leading-relaxed text-white/75" style="--d: 180ms">
          <span class="font-mono text-white">Erreur 404</span> — la page demandée ne figure pas, ou plus, dans nos comptes.
          Vérifiez l'adresse, ou repartez d'une page ci-dessous.
        </p>
      </div>

      <ul class="enter-rise divide-y divide-white/12 border-y border-white/12 lg:col-span-5 lg:self-end">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="group flex items-center justify-between gap-6 py-5">
                <span>
                  <span class="link-draw text-xl font-bold tracking-[-0.02em]">{link.label}</span>
                  <span class="mt-1 block text-[15px] text-white/65">{link.text}</span>
                </span>
                <Icon name="arrow-right" class="h-5 w-5 text-white/60 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-white" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-orli flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[17px] text-navy/75">
        Vous cherchiez un pôle&nbsp;?
        {
          poles.map((pole, i) => (
            <>
              {i > 0 && ' · '}
              <a href={pole.href} class="font-semibold text-navy underline decoration-navy/35 decoration-2 underline-offset-4 hover:decoration-navy">
                {pole.title}
              </a>
            </>
          ))
        }
      </p>
      <a href={company.phones[0].href} class="btn btn-line shrink-0">
        <Icon name="phone" class="h-4 w-4" />
        <span class="tabular">{company.phones[0].display}</span>
      </a>
    </div>
  </section>
</BaseLayout>
